# U20 charger source-route requirements, NOT a build-ready defconfig.
# No board automatically merges this fragment. audit_charger.py must reject
# the current donor even with these settings: its BQ24196 objects are absent.
# Merge with u20_pmic_legacy.config only after porting the actual charger owner.
CONFIG_ARCH_MT6755=y
CONFIG_I2C=y
CONFIG_MTK_I2C=y
CONFIG_MTK_I2C_EXTENSION=y
CONFIG_OF=y
CONFIG_MTK_SMART_BATTERY=y
CONFIG_MTK_BQ24196_SUPPORT=y
# CONFIG_MTK_CHARGER_INTERFACE is not set
# CONFIG_MTK_PMIC_NEW_ARCH is not set
# CONFIG_MTK_PMIC_CHIP_MT6353 is not set
