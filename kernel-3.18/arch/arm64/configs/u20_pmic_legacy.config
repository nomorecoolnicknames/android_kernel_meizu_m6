# U20 / MT6755 PMIC source-selection fragment, not a complete board defconfig.
# Apply only to an MT6755 U20 source profile; the 1MA DTS/board port is separate.
# Stock MCP proves the legacy MT6351 regulator/OF backend and PWRAP symbols.
# There is no CONFIG_MTK_PMIC_CHIP_MT6351 in this source tree.
CONFIG_MTK_PMIC=y
CONFIG_MTK_PMIC_WRAP=y
CONFIG_REGULATOR=y
CONFIG_OF=y
# CONFIG_MTK_PMIC_NEW_ARCH is not set
# CONFIG_MTK_PMIC_CHIP_MT6353 is not set
# CONFIG_MTK_LEGACY is not set
