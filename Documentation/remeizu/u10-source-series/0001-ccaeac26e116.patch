+    /* Exact U10 power-up ordering, four bounded stock attempts. */
+    for (reset_count = 0; reset_count < 4; reset_count++) {
+        tpd_gpio_output(GTP_INT_PORT, 0);
+        tpd_gpio_output(GTP_RST_PORT, 0);
+        msleep(20);
+        gt9xx_u10_set_power(1);
+        gtp_reset_guitar(client, 20);
+        ret = gtp_i2c_test(client);
+        if (ret >= 0)
+            return ret;
+    }
+    gt9xx_u10_set_power(0);
+    return -EIO;
+#else
 reset_proc:
     GTP_GPIO_OUTPUT(GTP_RST_PORT, 0);   
     GTP_GPIO_OUTPUT(GTP_INT_PORT, 0);
@@ -2080,6 +2123,7 @@ reset_proc:
         }
     }
     return ret;
+#endif /* CONFIG_TOUCHSCREEN_MTK_GT9XX_U10_STOCK_RESOURCES */
 }
 
 
