 #include "tpd.h"
 #include "tpd_custom_gt9xx.h"
 
+#ifdef CONFIG_TOUCHSCREEN_MTK_GT9XX_U10_STOCK_RESOURCES
+#include <mt_pmic_api_ldo.h>
+static struct regulator *gt9xx_u10_vtouch;
+static bool gt9xx_u10_powered;
+static int gt9xx_u10_probe_error;
+
+void gt9xx_u10_set_power(int enable)
+{
+    /* Stock U10 tpd_power_on uses this MT6353 API, not regulator_enable. */
+    pmic_ldo_vldo28_sw_en(enable);
+    gt9xx_u10_powered = !!enable;
+}
+
+static void gt9xx_u10_release_power(void)
+{
+    if (gt9xx_u10_powered)
+        gt9xx_u10_set_power(0);
+    if (gt9xx_u10_vtouch) {
+        regulator_put(gt9xx_u10_vtouch);
+        gt9xx_u10_vtouch = NULL;
+    }
+}
+#endif
+
 /* m681 3.18 graft: cust_gpio_usage.h does not exist on this tree; the GTP GPIO
  * port defines + macros are provided directly in tpd_custom_gt9xx.h above. */
 #ifdef TPD_PROXIMITY
@@ -201,7 +225,11 @@ static const struct i2c_device_id tpd_i2c_id[] = {{"gt9xx", 0}, {}};
  * i2c client, so the legacy board_info + address_list auto-detect are dropped,
  * exactly like the ft5436 port on this tree. */
 static const struct of_device_id gt9xx_dt_match[] = {
+#ifdef CONFIG_TOUCHSCREEN_MTK_GT9XX_U10_STOCK_RESOURCES
+    {.compatible = "mediatek,cap_touch_gt"},
+#else
